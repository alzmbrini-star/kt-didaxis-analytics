# Nunca envie este arquivo preenchido ao Git.
# Cada chave do objeto representa o ID interno do tenant no portal.
DIDAXIS_TENANTS_JSON={"grupo-didaxis":{"name":"Grupo Didaxis","baseUrl":"https://didaxis.didaxis.com.br","username":"USUARIO_DO_APLICATIVO","password":"SENHA_DO_APLICATIVO","active":true}}

# Porta do servidor local.
PORT=5173

# Cache do dashboard em milissegundos. Reduz chamadas aos relatórios limitados
# a 10 requisições por minuto por aplicativo externo.
DIDAXIS_DASHBOARD_CACHE_MS=300000
